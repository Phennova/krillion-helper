{
  "manifest_version": 3,
  "name": "Krillion Helper",
  "version": "1.3.0",
  "description": "Reads the current Krillion prompt and lists answers, easiest to type first.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://krillion.io/*", "https://www.krillion.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
